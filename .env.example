NEXT_PUBLIC_SITE_URL=https://www.awtmods.in

# Supabase PostgreSQL Database URL
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT_ID].supabase.co

# Admin Session Secret
ADMIN_SESSION_SECRET=your-random-32-char-session-secret-here

# Cloudinary Credentials (for App Icon and Screenshots)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_URL=cloudinary://[API_KEY]:[API_SECRET]@[CLOUD_NAME]

# Cloudflare R2 Credentials (for APK and binary files)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_ENDPOINT=https://[ACCOUNT_ID].r2.cloudflarestorage.com
R2_API_TOKEN=your_r2_api_token
R2_BUCKET_NAME=awtmods-apks
R2_PUBLIC_BASE_URL=https://pub-[ACCOUNT_ID].r2.dev
